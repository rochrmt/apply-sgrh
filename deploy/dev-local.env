# SIGRHE · configuration de DÉMONSTRATION LOCALE (docker compose)
# Usage : cp deploy/dev-local.env .env  puis  docker compose up -d --build
# Fichier prévu pour être versionné : valeurs de développement uniquement, JAMAIS en production.
DJANGO_SECRET_KEY=dev-local-a-remplacer-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_HTTPS=0
TIME_ZONE=Africa/Bangui

POSTGRES_DB=sigrhe
POSTGRES_USER=sigrhe
POSTGRES_PASSWORD=sigrhe-dev-local

# Port HTTP de l'application (8000 par défaut ; ici 8888 car un autre service occupe 8000)
SIGRHE_PORT=8888
# Adresse d'écoute : 127.0.0.1 = machine locale seulement ; 0.0.0.0 = accessible depuis le réseau
SIGRHE_BIND=127.0.0.1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SIGRHE <notifications@sigrhe.gouv.cf>

SIGRHE_DEMO_MODE=1
SIGRHE_DEMO_PASSWORD=demo-sigrhe-2026
SEED_DEMO=1

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_SECONDS=28800
