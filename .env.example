# ===== SIGRHE · configuration du serveur (copier en .env et compléter) =====

# --- Django ---
# Clé secrète longue et aléatoire : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Nom(s) de domaine du serveur, séparés par des virgules
DJANGO_ALLOWED_HOSTS=sigrhe.gouv.cf
DJANGO_CSRF_TRUSTED_ORIGINS=https://sigrhe.gouv.cf
# 1 = cookies réservés à HTTPS (obligatoire en production)
DJANGO_HTTPS=1
TIME_ZONE=Africa/Bangui

# --- PostgreSQL (docker-compose construit DATABASE_URL à partir de ces valeurs) ---
POSTGRES_DB=sigrhe
POSTGRES_USER=sigrhe
POSTGRES_PASSWORD=
# Installation sans Docker : DATABASE_URL=postgres://sigrhe:MOT_DE_PASSE@localhost:5432/sigrhe
# DB_SSLMODE=require

# --- Courriels des notifications (serveur SMTP de l'État) ---
# Pour activer l'envoi réel : EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gouv.cf
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SIGRHE <notifications@sigrhe.gouv.cf>

# --- Assistant RH (IA) : clé API Anthropic, conservée uniquement sur le serveur ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ASSISTANT_MAX_PER_HOUR=60

# --- Sécurité des connexions ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_SECONDS=28800

# --- Mode démonstration (serveur de recette / soutenance de l'offre UNIQUEMENT) ---
# 1 = comptes de démonstration affichés sur la page de connexion + réinitialisation possible
SIGRHE_DEMO_MODE=0
SIGRHE_DEMO_PASSWORD=change-moi-demo
# 1 = charge les 306 agents fictifs et les 13 comptes de démonstration au démarrage
SEED_DEMO=0
